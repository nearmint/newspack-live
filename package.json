{
	"name": "newspack-live",
	"version": "1.2.0",
	"description": "Live coverage of developing stories for Newspack sites.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"author": "Nicolas Rapp",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "npm run build:app && npm run build:blocks",
		"build:app": "newspack-scripts wp-scripts build --output-path build/app",
		"build:blocks": "wp-scripts build --config webpack.blocks.config.js --experimental-modules --source-path=src/blocks --output-path=build/blocks --webpack-copy-php",
		"watch": "newspack-scripts wp-scripts start --output-path build/app",
		"watch:blocks": "wp-scripts start --config webpack.blocks.config.js --experimental-modules --source-path=src/blocks --output-path=build/blocks --webpack-copy-php",
		"lint": "npm run lint:js && npm run lint:scss",
		"lint:js": "newspack-scripts wp-scripts lint-js --no-error-on-unmatched-pattern \"src/**/*.{js,jsx,ts,tsx}\" \"tests/e2e/**/*.ts\" \"bin/*.mjs\" \"*.config.{js,ts}\"",
		"fix:js": "newspack-scripts wp-scripts lint-js --fix --no-error-on-unmatched-pattern \"src/**/*.{js,jsx,ts,tsx}\" \"tests/e2e/**/*.ts\" \"bin/*.mjs\" \"*.config.{js,ts}\"",
		"format:js": "newspack-scripts wp-scripts format \"src/**/*.{js,jsx,ts,tsx}\" \"tests/e2e/**/*.ts\" \"bin/*.mjs\"",
		"lint:scss": "newspack-scripts wp-scripts lint-style \"src/**/*.scss\" --customSyntax postcss-scss --max-warnings=0 --allow-empty-input",
		"format:scss": "newspack-scripts wp-scripts lint-style \"src/**/*.scss\" --customSyntax postcss-scss --fix --allow-empty-input",
		"typescript:check": "newspack-scripts typescript-check",
		"test": "newspack-scripts test",
		"test:e2e": "playwright test",
		"test:e2e:clean": "bin/wp.local.sh newspack-live clean-e2e",
		"changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
		"prepare": "husky",
		"test:load": "node bin/load-concurrent-publish.mjs",
		"test:budgets": "node bin/check-budgets.mjs",
		"release:archive": "bash bin/release-archive.sh",
		"check:version": "node bin/check-version.mjs",
		"i18n:pot": "bin/wp.local.sh i18n make-pot . languages/newspack-live.pot --slug=newspack-live --domain=newspack-live --exclude=node_modules,vendor,tests,release,docs,src,bin,test-results,playwright-report",
		"test:e2e:yoast": "NEWSPACK_LIVE_YOAST=1 playwright test --grep @yoast"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@playwright/test": "^1.55.0",
		"@wordpress/a11y": "^4.56.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/block-library": "^11.1.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/compose": "^8.9.0",
		"@wordpress/core-data": "^8.1.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/dom-ready": "^4.56.0",
		"@wordpress/editor": "^15.1.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/format-library": "^5.56.0",
		"@wordpress/hooks": "^4.56.0",
		"@wordpress/html-entities": "^4.56.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/interactivity": "^6.56.0",
		"@wordpress/keyboard-shortcuts": "^5.56.0",
		"@wordpress/media-utils": "^5.56.0",
		"@wordpress/notices": "^5.56.0",
		"@wordpress/plugins": "^7.56.0",
		"@wordpress/scripts": "^30.27.0",
		"@wordpress/server-side-render": "^6.32.0",
		"@wordpress/url": "^4.56.0",
		"conventional-changelog": "^8.1.3",
		"conventional-changelog-conventionalcommits": "^10.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"newspack-scripts": "^5.11.0",
		"prettier": "npm:wp-prettier@^3.0.3"
	},
	"overrides": {
		"prettier": "npm:wp-prettier@^3.0.3"
	}
}
