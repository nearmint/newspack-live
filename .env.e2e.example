# Copy to .env.e2e (gitignored). The Playwright global setup creates the users and syncs these passwords.
WP_BASE_URL=http://newspack.local
WP_E2E_ADMIN_USER=nl-e2e-admin
WP_E2E_ADMIN_PASS=change-me
WP_E2E_EDITOR_USER=nl-e2e-editor
WP_E2E_EDITOR_PASS=change-me
WP_E2E_AUTHOR_USER=nl-e2e-author
WP_E2E_AUTHOR_PASS=change-me
WP_E2E_CONTRIBUTOR_USER=nl-e2e-contributor
WP_E2E_CONTRIBUTOR_PASS=change-me
WP_E2E_SUBSCRIBER_USER=nl-e2e-subscriber
WP_E2E_SUBSCRIBER_PASS=change-me
